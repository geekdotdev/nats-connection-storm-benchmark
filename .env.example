# Copy to .env (gitignored) and fill in only what the commands you run need.
# Names only here: never put a real value in this file. Check which are set, without
# printing any value, with:  uv run bench keys
#
# CI does not use this file; it uses GitHub OIDC for AWS and the workflow's own token.

# Container registry the cluster pulls images from, as host/account, lowercase: ghcr.io/<user-or-org>.
# Needed by: images push. GHCR takes only a classic personal access token (fine-grained tokens are
# not accepted for packages): REGISTRY_TOKEN needs the write:packages scope. It is used for the login
# only and is not saved in the container tool's own login file.
REGISTRY=
REGISTRY_USER=
REGISTRY_TOKEN=

# Your GitHub login (not a secret). Needed by: run. It qualifies where a run's results go,
# results/<login>/<run>/, and every file of the run says who ran it, so that a maintainer or another developer
# who repeats a run keeps their results beside yours and never over them. Or pass --github-user.
GITHUB_USER=

# GitHub API: dispatch the workflow, download result artifacts. Needed by: ci dispatch, ci fetch.
# Prefer a fine-grained token limited to this repository (Actions: read/write), separate from
# REGISTRY_TOKEN, because a classic token reaches every repository the account can.
GITHUB_TOKEN=

# AWS for the EKS target. Prefer a profile (SSO or assume-role) over long-lived keys.
# Needed by: cluster up/down with --target eks.
AWS_PROFILE=
AWS_REGION=
# Optional EKS settings (defaults in infra/eks/README.md): STORM_EKS_CLUSTER, STORM_EKS_ZONE,
# STORM_EKS_INSTANCE_TYPE, STORM_EKS_K8S_VERSION, STORM_EKS_KUBECONFIG (default .kube/storm-bench-eks)
# Only if you must use static keys (discouraged):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
